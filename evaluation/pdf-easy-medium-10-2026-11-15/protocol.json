  "questions": [
    {
      "id": "Q01",
      "difficulty": "Easy",
      "query": "Does drinking coffee affect sleep?",
      "information_need": "Human coffee/caffeine consumption and sleep quality, duration or onset; caffeine trials qualify as constituent evidence."
    },
    {
      "id": "Q02",
      "difficulty": "Easy",
      "query": "Does reducing salt intake lower blood pressure?",
      "information_need": "Human dietary salt/sodium reduction and measured blood pressure; potassium-only interventions are partial background."
    },
    {
      "id": "Q03",
      "difficulty": "Easy",
      "query": "Does eating more fiber help with constipation?",
      "information_need": "Human dietary fiber or fiber supplementation and constipation, stool frequency or consistency; other digestive outcomes alone are background."
    },
    {
      "id": "Q04",
      "difficulty": "Easy",
      "query": "Does drinking milk help keep bones strong?",
      "information_need": "Human milk/dairy intake and bone density, bone mineral content, fractures or bone turnover; dairy mixtures can be directly useful but are less specific than milk."
    },
    {
      "id": "Q05",
      "difficulty": "Easy",
      "query": "Does boiling vegetables reduce their vitamin C content?",
      "information_need": "Measured vitamin C/ascorbic acid retention after boiling vegetables; food laboratory studies are directly applicable, unlike human-health queries."
    },
    {
      "id": "Q06",
      "difficulty": "Medium",
      "query": "Does eating oats lower LDL cholesterol?",
      "information_need": "Human oat/oat beta-glucan consumption and LDL cholesterol; other cereal fibers or other lipid outcomes alone are partial evidence."
    },
    {
      "id": "Q07",
      "difficulty": "Medium",
      "query": "Does eating nuts cause weight gain in adults?",
      "information_need": "Adult human nut consumption and body weight/adiposity; includes null findings and energy compensation, not only weight gain."
    },
    {
      "id": "Q08",
      "difficulty": "Medium",
      "query": "Is yogurt easier to digest than milk for people with lactose intolerance?",
      "information_need": "Human yogurt/fermented milk versus ordinary milk or lactose digestion in lactose malabsorbers; generic probiotic/gut health studies without lactose outcomes are background."
    },
    {
      "id": "Q09",
      "difficulty": "Medium",
      "query": "Are sugary drinks linked to type 2 diabetes?",
      "information_need": "Human sugar-sweetened beverage intake and type 2 diabetes incidence/risk; association is sufficient, causality is not required; glucose/weight alone is partial evidence."
    },
    {
      "id": "Q10",
      "difficulty": "Medium",
      "query": "Does extra protein help build muscle during resistance training?",
      "information_need": "Human dietary protein supplementation/intake during resistance training and muscle mass or hypertrophy; strength alone or exercise without protein comparison is partial evidence."
    }
